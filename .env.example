# Local: values printed by `npx supabase start`. Vercel: set per environment (Preview -> staging, Production -> prod).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<anon / publishable key>
# Server only. Never prefix with NUXT_PUBLIC_.
NUXT_SUPABASE_SERVICE_KEY=<service role key>
# Optional, server only: AI providers for recommendations (pick one in 后台 → 推荐算法).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_COMPAT_BASE_URL=
LLM_COMPAT_API_KEY=
# Web push (docs/push-notifications.md). Generate keys with `npx web-push generate-vapid-keys`.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only.
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:support@example.com
NUXT_PUSH_DISPATCH_SECRET=
# Dynamic per-user ranking. Requires the new migration and server service key above.
# false immediately falls back to the original static weights and stops snapshot collection.
NUXT_DYNAMIC_RECOMMENDATIONS_ENABLED=true

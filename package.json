{
  "name": "shuaqi-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run --passWithNoTests",
    "test:adaptive": "node --test tests/adaptive-core.mjs",
